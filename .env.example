# Google OAuth 2.0 Web client (Google Cloud Console → APIs & Services → Credentials).
# Authorized JavaScript origins: http://localhost:3000 (and your production URL).
# Authorized redirect URIs: same origins (required for refresh-token / code flow).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server-side OAuth (refresh tokens + 24h signed-in session). Generate a long random string.
AUTH_SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_SECRET=your-client-secret

# Enable code flow + /api/auth/refresh (requires secrets above).
NEXT_PUBLIC_GOOGLE_SERVER_AUTH=true
