# Google OAuth 2.0 Web client ID (Google Cloud Console → APIs & Services → Credentials).
# Add http://localhost:3000 to the client's "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Picker. The app uses the drive.file scope, so users grant files through
# Google's picker. Both values come from the same Cloud project:
#   API key   → APIs & Services → Credentials → Create credentials → API key
#               (restrict it to the Google Picker API and your origins)
#   App ID    → the project *number* shown on the Cloud Console dashboard
NEXT_PUBLIC_GOOGLE_API_KEY=your-browser-api-key
NEXT_PUBLIC_GOOGLE_APP_ID=123456789012
